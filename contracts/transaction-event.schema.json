{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FraudWatchPlusTransactionEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "transaction_id", "event_version", "event_type",
    "event_timestamp", "transaction_timestamp", "customer_id", "card_id",
    "merchant_id", "merchant_category", "merchant_country", "device_id",
    "ip_address", "channel", "amount", "currency", "status",
    "is_fraud", "source_system"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 8, "maxLength": 64},
    "transaction_id": {"type": "string", "minLength": 8, "maxLength": 64},
    "event_version": {"type": "integer", "minimum": 1},
    "event_type": {"type": "string"},
    "event_timestamp": {"type": "string", "format": "date-time"},
    "transaction_timestamp": {"type": "string", "format": "date-time"},
    "customer_id": {"type": "string"},
    "card_id": {"type": "string"},
    "merchant_id": {"type": "string"},
    "merchant_category": {"type": "string"},
    "merchant_country": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "device_id": {"type": "string"},
    "ip_address": {"type": "string"},
    "channel": {"enum": ["POS", "ECOMMERCE", "ATM", "MOBILE"]},
    "amount": {"type": "number", "exclusiveMinimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "status": {"enum": ["AUTHORIZED", "DECLINED", "REVERSED"]},
    "is_fraud": {"type": ["boolean", "null"]},
    "source_system": {"type": "string"}
  }
}
